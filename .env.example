# Copy to .env and fill in real values. Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=tprm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tprm
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Backend ---
# SQLAlchemy connection string built from the above by default; override if needed.
DATABASE_URL=postgresql+psycopg://tprm:changeme@postgres:5432/tprm
APP_ENV=development
LOG_LEVEL=INFO
SCAN_TIMEOUT_SECONDS=30
SCAN_MIN_INTERVAL_MINUTES=15

# --- Recurring scan scheduler ---
# Re-scan a vendor once its last completed scan is older than this.
SCAN_INTERVAL_DAYS=7
# The scheduler wakes this often and queues at most SCHEDULER_BATCH_SIZE
# vendors each time, so a weekly cadence trickles out over hours instead of
# firing every vendor at once.
SCHEDULER_TICK_MINUTES=30
SCHEDULER_BATCH_SIZE=2

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Future intelligence provider API keys (unused in Phase 1) ---
# SHODAN_API_KEY=
# NVD_API_KEY=
